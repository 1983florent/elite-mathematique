{
  "name": "elite-analyseur-plagiat",
  "productName": "Analyseur ELITE MATHEMATIQUE",
  "version": "1.0.0",
  "description": "Analyseur de plagiat, humanisation, forensique et vérification des citations — application de bureau hors ligne.",
  "author": "ELITE MATHEMATIQUE",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.elitemathematique.plagiat",
    "productName": "Analyseur ELITE MATHEMATIQUE",
    "copyright": "© ELITE MATHEMATIQUE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../plagiat",
        "to": "app/plagiat"
      },
      {
        "from": "../logo.png",
        "to": "app/logo.png"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Analyseur ELITE"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "ELITE MATHEMATIQUE"
    }
  }
}
