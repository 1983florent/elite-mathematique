# Variables d'environnement du backend de paiement Veritex (FedaPay).
# À définir dans Netlify (Project configuration → Environment variables) ou
# Vercel (Settings → Environment Variables). NE JAMAIS committer les vraies
# valeurs : ce fichier n'est qu'un modèle.

# Clé SECRÈTE FedaPay (jamais dans le front).
# Test : "sk_sandbox_..."  /  Production : "sk_live_..."
FEDAPAY_SECRET_KEY=COLLEZ_VOTRE_CLE_SECRETE_FEDAPAY_ICI

# (Optionnel) Base de l'API FedaPay. Laissez vide : elle est déduite de la clé
# (sandbox si la clé contient "sandbox", sinon production).
#   Sandbox   : https://sandbox-api.fedapay.com/v1
#   Production: https://api.fedapay.com/v1
FEDAPAY_BASE_URL=

# Prix en FCFA (XOF). Doivent correspondre aux libellés affichés dans
# plagiat/js/core/license.js (plans).
AMOUNT_MENSUEL=3000
AMOUNT_ANNUEL=25000

# Clé PRIVÉE de signature des codes d'accès (PKCS8, base64).
# Générez la paire avec : node tools/make-license.mjs --cles
# → collez la PUBLIQUE dans plagiat/js/core/license.js (publicKeySpki)
# → mettez la PRIVÉE ici (secret serveur).
LICENSE_PRIVATE_KEY=COLLEZ_VOTRE_CLE_PRIVEE_BASE64_ICI

# (Optionnel) Origine autorisée pour CORS si le front est sur un autre domaine.
# Laissez vide pour un déploiement même-origine (recommandé).
ALLOW_ORIGIN=

# (Optionnel) URL publique du site, utilisée pour les retours de paiement
# si l'origine n'est pas transmise par la requête.
PUBLIC_URL=
