# Variables d'environnement du backend de paiement Veritex.
# À définir dans Vercel (Settings → Environment Variables) ou Netlify
# (Site settings → Environment variables). NE JAMAIS committer les vraies
# valeurs : ce fichier n'est qu'un modèle.

# Clé SECRÈTE Stripe (jamais dans le front). Format : "sk_test_…" (test) ou
# "sk_live_…" (production). Collez ici votre vraie clé côté serveur uniquement.
STRIPE_SECRET_KEY=COLLEZ_VOTRE_CLE_SECRETE_STRIPE_ICI

# Identifiants de PRIX Stripe (créés dans Stripe → Produits → Tarifs).
# Un prix récurrent par offre (format "price_…").
STRIPE_PRICE_MENSUEL=COLLEZ_VOTRE_PRICE_ID_MENSUEL_ICI
STRIPE_PRICE_ANNUEL=COLLEZ_VOTRE_PRICE_ID_ANNUEL_ICI

# Clé PRIVÉE de signature des codes d'accès (PKCS8, base64).
# Générez la paire avec : node tools/make-license.mjs --cles
# → collez la PUBLIQUE dans plagiat/js/core/license.js (publicKeySpki)
# → mettez la PRIVÉE ici (secret serveur).
LICENSE_PRIVATE_KEY=COLLEZ_VOTRE_CLE_PRIVEE_BASE64_ICI

# (Optionnel) Origine autorisée pour CORS si le front est sur un autre domaine.
# Laissez vide pour un déploiement même-origine (recommandé).
ALLOW_ORIGIN=

# (Optionnel) URL publique du site, utilisée pour les retours de paiement
# si l'origine n'est pas transmise par la requête.
PUBLIC_URL=
